generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayerSession {
  id        String   @id @default(cuid())
  callsign  String   @unique
  groqKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations   Operation[]
  mutationLogs MutationLog[]
}

model Operation {
  id             String   @id @default(cuid())
  sessionId      String
  session        PlayerSession @relation(fields: [sessionId], references: [id])
  opCode         String
  status         String   @default("available")
  hardeningLevel Int      @default(1)
  currentSecret  String?
  apiCallCount   Int      @default(0)
  apiCallBudget  Int      @default(10000)
  startedAt      DateTime?
  solvedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions   OperationSubmission[]
  mutationLogs  MutationLog[]
}

model OperationSubmission {
  id            String    @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id])
  guess         String
  isCorrect     Boolean
  apiCallsUsed  Int
  scoreBreakdown String?
  createdAt     DateTime  @default(now())
}

model KVStore {
  key       String    @id
  value     String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MutationLog {
  id              String    @id @default(cuid())
  sessionId       String?
  session         PlayerSession? @relation(fields: [sessionId], references: [id])
  operationId     String?
  operation       Operation? @relation(fields: [operationId], references: [id])
  opCode          String
  hardeningLevel  Int
  ttpName         String
  ttpCategory     String
  description     String
  mutationApplied String
  previousConfig  String?
  newConfig       String?
  createdAt       DateTime  @default(now())
}
